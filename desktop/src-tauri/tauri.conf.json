{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sliptab",
  "version": "1.0.1",
  "identifier": "com.asinadarsh.edge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sliptab",
        "width": 8,
        "height": 120,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Notes on the edge of your screen",
    "longDescription": "Quick-capture notes in a thin bar on the edge of your screen. Hover or press a hotkey to open.",
    "copyright": "Copyright (C) 2026 Adarsh Kumar Singh. GPL-3.0-only.",
    "publisher": "Adarsh Kumar Singh",
    "license": "GPL-3.0-only",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "licenseFile": "windows/installer-notice.txt"
  },
  "mainBinaryName": "edge",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQ0E0Qjc0NUFCMkUyQjcKUldTMzRySmFkRXZLM3k5Q2tzcnlRTUZiaXIrVTBuUS9leGVjVEZoUTdYa05sNHNRUVY1RW1ENCsK",
      "endpoints": [
        "https://edge-sync.forcesync.in/v1/app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
